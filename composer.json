{
    "name": "rimba/kerja",
    "keywords": [
        "rimba",
        "laravel",
        "filament",
        "workflow",
        "work",
        "offering"
    ],
    "description": "Execution layer for tasks, checklists, and work packages.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BIT Ecosystem",
            "email": "bit.ecosystem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "filament/filament": "^5.0",
        "packstub/filament-flow": "^1.0",
        "packstub/filament-form-builder": "^1.0",
        "rimba/asas": "^1.3",
        "rimba/jejak": "^1.3",
        "rimba/orang": "^1.3",
        "rimba/pihak": "^1.3",
        "spatie/laravel-package-tools": "^1.0",
        "spatie/laravel-permission": "^7.3"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rimba\\Work\\WorkServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Rimba\\Work\\": "src/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}